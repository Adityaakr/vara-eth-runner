   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Two views of one program state:\n\u2022 pre-confirmed = validator's answer, ms old\n\u2022 committed = replay of Ethereum logs only\nThe gap between them is what the page measures.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "Two views of one program state:\n\u2022 pre-confirmed = validator's answer, ms old\n\u2022 committed = replay of Ethereum logs only\nThe gap between them is what the page measures.",
   "lineHeight": 1.25,
   "baseline": 14
  },
